# Salin file ini jadi .env lalu isi dengan nilai dari project Supabase kamu.
# Dashboard Supabase > Project Settings > API
#
# Keduanya aman ada di sisi browser: anon key dibatasi Row Level Security.
# JANGAN pernah menaruh service_role key di sini, itu melewati semua RLS.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Alamat layanan ekstraksi CV (dipakai form profil) dan alamat dasar asisten AI.
# Kosongkan keduanya saat sudah di Vercel: defaultnya function di domain yang sama.
# Saat development jalankan `python3 scripts/dev_api_server.py` lalu isi:
# VITE_CV_EXTRACT_URL=http://localhost:8787/api/extract-cv
# VITE_AI_BASE_URL=http://localhost:8787
VITE_CV_EXTRACT_URL=
VITE_AI_BASE_URL=

# Key Anthropic untuk Brief Assistant dan Search Assistant. TANPA awalan VITE_, karena apa pun
# yang berawalan VITE_ ikut tertanam di bundel JavaScript yang dikirim ke browser. Ini cuma
# dibaca serverless function di sisi server, dan harus didaftarkan juga di Vercel Environment
# Variables supaya kedua asisten hidup di produksi.
ANTHROPIC_API_KEY=

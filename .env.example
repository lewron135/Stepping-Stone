# Salin file ini jadi .env lalu isi dengan nilai dari project Supabase kamu.
# Dashboard Supabase > Project Settings > API
#
# Keduanya aman ada di sisi browser: anon key dibatasi Row Level Security.
# JANGAN pernah menaruh service_role key di sini, itu melewati semua RLS.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
